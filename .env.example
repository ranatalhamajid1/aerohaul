# Backend Configuration
SECRET_KEY=change-this-in-production-to-a-secure-random-string
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: OpenRouteService API Key (free at openrouteservice.org)
# If omitted, system seamlessly falls back to public OSRM + intelligent waypoint synthesis
ORS_API_KEY=

# Optional Redis Cache (defaults to in-memory LocMemCache if not set)
# REDIS_URL=redis://127.0.0.1:6379/1
